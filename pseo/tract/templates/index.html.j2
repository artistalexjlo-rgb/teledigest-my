{% extends "base.html.j2" %}

{% block crumbs %}
  {%- if page.geo %}
  <nav class="crumbs">
    <a href="/{{ t.html_lang }}/">{{ t.crumbs_home }}</a> /
    <b>{{ page.geo_name }}</b>
  </nav>
  {%- elif page.crumb_label %}
  <nav class="crumbs">
    <a href="/{{ t.html_lang }}/">{{ t.crumbs_home }}</a> /
    <b>{{ page.crumb_label }}</b>
  </nav>
  {%- endif %}
{% endblock %}

{% block content %}
  {%- if page.home %}
  {#- ГЛАВНАЯ (17.09, устройство старой): h1 + интро + «Популярные» с вайбом + регионы
      аккордеоном. Тексты — i18n (home_*), структура — site.home(). #}
  <h1>{{ t.home_h1 }}</h1>
  <div class="plate answer">{{ oct(OCT_BOX, 12, 3) }}<div class="pad">{{ t.home_intro | safe }}</div></div>
  {%- if page.popular %}
  <h2>{{ t.home_countries_label }}</h2>
  <span class="section-label">{{ t.home_popular }}</span>
  <div class="grid">
    {%- for c in page.popular %}
    <a class="card" href="{{ c.url }}">{{ oct(OCT_BOX, 12, 3) }}<span class="ti"><span class="fl">{{ c.flag }}</span> {{ c.name }}</span><span class="ds">{{ c.vibe or t.geo_blurb }} · {{ c.n }}</span></a>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- if page.regions %}
  <span class="section-label" style="margin-top:22px">{{ t.home_by_region }}</span>
  <div class="regions">
    {%- for r in page.regions %}
    <details class="reg"{% if loop.first %} open{% endif %}><summary>{{ t.region_names[r.key] }}<span class="cnt">{{ r.geos | length }}</span></summary>
      <div class="rlist">
        {%- for c in r.geos %}
        <a href="{{ c.url }}">{{ c.flag }} {{ c.name }}</a>
        {%- endfor %}
      </div>
    </details>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- else %}
  <h1>{{ page.h1 }}</h1>

  {%- if page.image %}
  <img class="hub-img" src="/images/{{ page.image }}" alt="" loading="lazy">
  {%- endif %}

  {%- if page.body %}{# служебная страница со своей прозой (about) — тема текста не несёт #}
  <div class="prose">{{ page.body | safe }}</div>
  {%- endif %}

  {%- if page.tiles %}
  {%- if page.list_label %}<h2>{{ page.list_label }}</h2>{% endif %}
  <div class="grid">
    {%- for it in page.tiles %}
    {%- if it.soon %}
    <span class="card soon">{{ oct(OCT_BOX, 12, 3) }}<span class="ti">{{ it.icon }} {{ it.title }}</span>{% if it.blurb %}<span class="ds">{{ it.blurb }}</span>{% endif %}</span>
    {%- else %}
    <a class="card" href="{{ it.url }}">{{ oct(OCT_BOX, 12, 3) }}<span class="ti">{{ it.icon }} {{ it.title }}</span>{% if it.blurb %}<span class="ds">{{ it.blurb }}</span>{% endif %}</a>
    {%- endif %}
    {%- endfor %}
  </div>
  {%- endif %}

  {%- if page.faqs %}{# мелочь остатка темы: пунктов меньше порога ветки #}
  <div class="faqs">
  {%- for f in page.faqs %}
  <details><summary><span class="sumq">{{ f.q }}</span><span></span></summary>
    <div class="a">{{ f.a | safe }}</div>
  </details>
  {%- endfor %}
  </div>
  {%- endif %}
  {%- endif %}

  <div class="plate cta">{{ oct(OCT_BOX, 12, 3) }}<div class="pad">
    <p>{{ cta.voice_lead }} {{ cta.voice }}.</p>
    <a class="btn" href="{{ door }}" target="_blank" rel="noopener">{{ oct(OCT_BTN, 6, 2) }}<span>{{ t.cta_btn }}</span></a>
  </div></div>
{% endblock %}
