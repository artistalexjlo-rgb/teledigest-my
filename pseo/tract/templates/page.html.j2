{% extends "base.html.j2" %}

{% block crumbs %}
  <nav class="crumbs">
    <a href="/{{ t.html_lang }}/">{{ t.crumbs_home }}</a> /
    <a href="/{{ t.html_lang }}/{{ page.geo }}/">{{ page.geo_name }}</a> /
    {%- if page.shelf_url %}
    <a href="{{ page.shelf_url }}">{{ page.shelf_name }}</a> /
    {%- endif %}
    <b>{{ page.intent_name }}</b>
  </nav>
{% endblock %}

{% block content %}
  <h1>{{ page.h1 }}</h1>

  {%- if page.image %}
  <img class="page-img" src="/images/{{ page.image }}" alt="" loading="lazy">
  {%- endif %}

  {%- if page.parts %}
  {# Переходы по частям ОДНОЙ ветки. Цифрами, без слов: ветка выходит на тему одной
     плиткой, и новый ключ перевода на 14 языков ради «часть 2 из 3» тут не нужен. #}
  <nav class="parts">
    {%- for c in page.parts %}
    {%- if c.current %}<b>{{ c.n }}</b>{% else %}<a href="{{ c.url }}">{{ c.n }}</a>{% endif %}
    {%- endfor %}
  </nav>
  {%- endif %}

  <div class="faqs">
  {%- for f in page.faqs %}
  <details{% if loop.first %} open{% endif %}><summary><span class="sumq">{{ f.q }}</span><span></span></summary>
    <div class="a">{{ f.a | safe }}</div>
  </details>
  {%- endfor %}
  </div>

  <div class="plate cta">{{ oct(OCT_BOX, 12, 3) }}<div class="pad">
  {%- if cta %}
    <h2>{{ cta.hook }}</h2>
    <p>{{ cta.assistant_lead }} {{ cta.assistant }}.</p>
    <p>{{ cta.voice_lead }} {{ cta.voice }}.</p>
    <p class="ps">{{ cta.ps }}</p>
  {%- else %}
    <h2>{{ t.cta_hook }}</h2>
    <p>{{ page.cta_text }}</p>
  {%- endif %}
    <a class="btn" href="{{ door }}" target="_blank" rel="noopener">{{ oct(OCT_BTN, 6, 2) }}<span>{{ t.cta_btn }}</span></a>
  </div></div>
{% endblock %}

{% block jsonld %}
{# ItemList, не FAQPage: заголовки — лид-фразы советов, не вопросы (канон: LLM не сочиняет) #}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"ItemList","itemListElement":[
{%- for f in page.faqs %}
{"@type":"ListItem","position":{{ loop.index }},"name":{{ f.q | tojson }}}{{ "," if not loop.last }}
{%- endfor %}
]}
</script>
{% endblock %}
